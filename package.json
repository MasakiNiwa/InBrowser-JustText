{
  "name": "inbrowser-justtext",
  "version": "0.4.0",
  "private": true,
  "description": "Open a text file in your browser, edit it, and save it back out as a separate download",
  "type": "module",
  "scripts": {
    "test": "node --test \"test/*.test.js\"",
    "serve": "node scripts/serve.js",
    "test:browser": "node test/browser/e2e.mjs",
    "test:browser:firefox": "JUSTTEXT_BROWSER=firefox node test/browser/e2e.mjs",
    "test:browser:webkit": "JUSTTEXT_BROWSER=webkit node test/browser/e2e.mjs"
  },
  "license": "MIT"
}
