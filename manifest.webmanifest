{
  "name": "InBrowser JustText",
  "short_name": "JustText",
  "description": "Edit text files in your browser and save them — find & replace, automatic encoding detection, works offline.",
  "lang": "en",
  "dir": "ltr",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#11151a",
  "theme_color": "#11151a",
  "categories": [
    "utilities",
    "productivity"
  ],
  "icons": [
    {
      "src": "./assets/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./assets/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./assets/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "./assets/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml"
    }
  ],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "file",
          "accept": [
            "text/*",
            "application/json",
            "application/xml",
            "application/yaml",
            ".txt",
            ".text",
            ".json",
            ".jsonl",
            ".md",
            ".markdown",
            ".csv",
            ".tsv",
            ".log",
            ".ini",
            ".cfg",
            ".conf",
            ".env",
            ".yml",
            ".yaml",
            ".toml",
            ".xml",
            ".html",
            ".htm",
            ".css",
            ".js",
            ".ts",
            ".py",
            ".rb",
            ".sh",
            ".sql",
            ".srt",
            ".vtt",
            ".gpx",
            ".svg"
          ]
        }
      ]
    }
  },
  "file_handlers": [
    {
      "action": "./",
      "accept": {
        "text/plain": [
          ".txt",
          ".text",
          ".md",
          ".markdown",
          ".log",
          ".csv",
          ".tsv",
          ".ini",
          ".cfg",
          ".conf",
          ".properties",
          ".env",
          ".toml",
          ".sh",
          ".bash",
          ".zsh",
          ".bat",
          ".cmd",
          ".ps1",
          ".py",
          ".rb",
          ".pl",
          ".lua",
          ".r",
          ".js",
          ".mjs",
          ".cjs",
          ".ts",
          ".tsx",
          ".jsx",
          ".java",
          ".kt",
          ".dart",
          ".swift",
          ".go",
          ".rs",
          ".php",
          ".c",
          ".h",
          ".cpp",
          ".hpp",
          ".cs",
          ".css",
          ".scss",
          ".sql",
          ".gradle",
          ".srt",
          ".vtt",
          ".gpx"
        ],
        "application/json": [
          ".json",
          ".jsonl",
          ".geojson"
        ],
        "application/xml": [
          ".xml",
          ".svg",
          ".plist"
        ],
        "application/yaml": [
          ".yml",
          ".yaml"
        ],
        "text/html": [
          ".html",
          ".htm"
        ]
      }
    }
  ]
}
